#!/usr/bin/env bash

set -euo pipefail

DEFAULT_SERVER="root@139.196.140.215"
SERVER="${1:-${DEFAULT_SERVER}}"
REPO_DIR="/opt/auto-invoice-issuance/current"
VENV_DIR="/opt/auto-invoice-issuance/venv"
ENV_FILE="/etc/auto-invoice-issuance.env"
EMPTY_ENV_FILE="/dev/null"
RUN_AS_USER="invoicebot"

SSH_OPTS=(
  -o BatchMode=yes
  -o StrictHostKeyChecking=no
  -o ConnectTimeout=10
)

usage() {
  cat <<'EOF'
Usage:
  ./run-once-server [server]

Examples:
  ./run-once-server
  ./run-once-server root@139.196.140.215
  ./run-once-server local
EOF
}

run_once() {
  systemd-run --wait --collect \
    -p "User=${RUN_AS_USER}" \
    -p "WorkingDirectory=${REPO_DIR}" \
    -p "EnvironmentFile=${ENV_FILE}" \
    "${VENV_DIR}/bin/python" \
    -m app.main run-once --env-file "${EMPTY_ENV_FILE}"
}

main() {
  if [[ "${SERVER}" == "help" || "${SERVER}" == "-h" || "${SERVER}" == "--help" ]]; then
    usage
    exit 0
  fi

  if [[ "${SERVER}" == "local" || "${SERVER}" == "localhost" ]]; then
    run_once
    exit 0
  fi

  if [[ -d "${REPO_DIR}/.git" && "${SERVER}" == "${DEFAULT_SERVER}" ]]; then
    run_once
    exit 0
  fi

  ssh "${SSH_OPTS[@]}" "${SERVER}" \
    "$(declare -f run_once); REPO_DIR='${REPO_DIR}'; VENV_DIR='${VENV_DIR}'; ENV_FILE='${ENV_FILE}'; EMPTY_ENV_FILE='${EMPTY_ENV_FILE}'; RUN_AS_USER='${RUN_AS_USER}'; run_once"
}

main "$@"
