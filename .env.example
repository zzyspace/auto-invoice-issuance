OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=qwen3.5-flash
OPENAI_SSL_VERIFY=true
OPENAI_CA_BUNDLE_PATH=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=robot@example.com
SMTP_TO=finance@example.com
TEMPLATE_XLSX_PATH=./(V260401版)批量开票-导入开票模板.xlsx
STATE_DB_PATH=./data/state.db
STORES_CONFIG_PATH=./stores.yaml
BACKUPS_ROOT=./backups
RUN_HOUR=22
RUN_MINUTE=30
OPENAI_TIMEOUT_SECONDS=60
SURVEY_TIMEOUT_SECONDS=60
SURVEY_SSL_VERIFY=true
SURVEY_CA_BUNDLE_PATH=
TAX_LOOKUP_PROVIDER=disabled
TAX_LOOKUP_ALAPI_TOKEN=
