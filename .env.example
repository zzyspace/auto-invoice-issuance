TZ=Asia/Shanghai
TENCENT_SURVEY_COOKIE=your_cookie_here
TENCENT_SURVEY_EXPORT_URL=https://wj.qq.com/api/answer_exports/generate
TENCENT_SURVEY_EXPORT_METHOD=POST
TENCENT_SURVEY_EXPORT_BODY_TEMPLATE={"survey_id":"{{survey_id}}","type":"excel","ip_unique":false,"query":{},"location":{},"duration":{},"sort":"ended_at","order":"desc","from":"{{from_datetime}}","to":"{{to_datetime}}","channels":[],"respondent_nickname":"","status":"valid","q":"","contact_group_ids":[],"query_datetime":{},"query_text":{},"custom_args":[],"is_hide_sensitive_data":false}
TENCENT_SURVEY_EXPORT_DOWNLOAD_URL_PATH=
TENCENT_SURVEY_DEFAULT_UPLOAD_QUESTION_ID=q-6-VwdW
TENCENT_SURVEY_EXTRA_HEADERS_JSON={"Referer":"https://wj.qq.com/"}
